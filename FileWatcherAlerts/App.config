<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="fileWatcher"
             type="FileWatcherAlerts.Configuration.WatcherConfigSection, FileWatcherAlerts" />
  </configSections>

  <appSettings>
    <!-- How often to poll directories, in seconds -->
    <add key="PollingIntervalSeconds" value="60" />
    <!-- Log file path (relative or absolute) -->
    <add key="LogFilePath" value="filewatcher.log" />
  </appSettings>

  <fileWatcher>
    <!--
      SMTP settings for sending email alerts.
      Set useSsl="true" for TLS/STARTTLS connections.
    -->
    <smtp host="smtp.company.com"
          port="587"
          useSsl="true"
          username="alerts@company.com"
          password="your-password-here"
          fromAddress="alerts@company.com" />

    <!--
      Directories to monitor.
      - path:             UNC path (\\server\share) or mapped drive (Z:\folder)
      - filePattern:      Wildcard pattern (default: *)
      - stabilityMinutes: File must be unchanged for this many minutes before alerting.
                          Use 60 for 1 hour, 1440 for 1 day, 10080 for 1 week.
      - recipients:       Semicolon-delimited email addresses to notify.
    -->
    <directories>
      <add path="\\server\share\incoming"
           filePattern="*.csv"
           stabilityMinutes="30"
           recipients="team@company.com;ops@company.com" />
      <add path="\\server\reports"
           filePattern="*.xlsx"
           stabilityMinutes="1440"
           recipients="finance@company.com" />
    </directories>
  </fileWatcher>
</configuration>
